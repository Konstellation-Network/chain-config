{
  "name": "@konstellation-network/chain-config",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Chain metadata and canonical contract addresses for the Konstellation network (konstellation-1, devnet-1, testnet-1, local dev), shaped for viem, wagmi and EIP-3085 wallet_addEthereumChain.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:dist": "node --test test/dist.test.ts",
    "prepack": "npm run build && npm run test:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konstellation-Network/chain-config.git"
  },
  "homepage": "https://github.com/Konstellation-Network/chain-config#readme",
  "keywords": [
    "konstellation",
    "kash",
    "evm",
    "cosmos",
    "chain-config",
    "viem",
    "wagmi"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "viem": "2.56.8"
  }
}
